# Syslog endpoint for production logging.
# When set, replaces file-based JSON logging with syslog output.
# Format: <protocol>://<host>:<port>
# Examples:
#   SYSLOG_URL=udp://localhost:5514
#   SYSLOG_URL=tcp://syslog.example.com:514
# Leave empty to use default file logging (logs/app.log via lumberjack).
SYSLOG_URL=udp://localhost:5514